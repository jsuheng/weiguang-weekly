# Application
NODE_ENV=production
APP_ENV=production
APP_VERSION=local
APP_BASE_URL=https://weekly.internal.example
# auto follows APP_BASE_URL; set false only for temporary intranet HTTP.
COOKIE_SECURE=auto
PASSWORD_PEPPER=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL
POSTGRES_DB=weiguang
POSTGRES_USER=weiguang
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://weiguang:replace-with-a-strong-database-password@postgres:5432/weiguang
DATABASE_POOL_SIZE=10

# Server filesystem storage
# Path inside the app container.
FILE_STORAGE_DIR=/data/files
# Persistent path on the Docker host.
FILE_STORAGE_HOST_PATH=/data/weiguang/files

# Container image supplied by GitLab CI
APP_IMAGE=harbor.zlpv.com/group/weiguang-weekly:latest
